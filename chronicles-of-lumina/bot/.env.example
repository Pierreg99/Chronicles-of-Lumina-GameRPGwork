# === Chronicles of Lumina — Discord Bot ===
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Bot-Token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=PASTE_TOKEN_HERE

# Application (Client) ID from the same page — needed for slash-command registration
DISCORD_CLIENT_ID=PASTE_CLIENT_ID_HERE

# Test-Server-Guild-ID — commands register instantly here. Omit to register globally (slow).
# DISCORD_GUILD_ID=PASTE_GUILD_ID_HERE

# Welcome-Channel for new-member greetings
WELCOME_CHANNEL_ID=PASTE_CHANNEL_ID_HERE

# Screenshot-Channel for auto-reactions
SCREENSHOT_CHANNEL_ID=PASTE_CHANNEL_ID_HERE

# Data directory for reports / suggestions / leaderboard (default: ./data)
# DATA_DIR=./data

# === GitHub-Releases-Integration (optional) ===
# When set, /patch creates a draft GitHub-Release with the same notes.
# PAT must have `repo` scope (classic) or `contents: write` (fine-grained).
# GITHUB_TOKEN=ghp_PASTE_TOKEN_HERE
# GITHUB_REPO=Pierreg99/Lumina-Game
